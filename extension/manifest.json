{
  "manifest_version": 3,
  "name": "rotblock",
  "version": "0.1.0",
  "description": "Hide YouTube Shorts and redirect Shorts links to YouTube home.",
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"],
  "content_scripts": [{
    "matches": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"],
    "css": ["content.css"],
    "js": ["core.js", "content.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "declarative_net_request": {
    "rule_resources": [{ "id": "shorts", "enabled": true, "path": "rules.json" }]
  },
  "browser_specific_settings": {
    "gecko_android": { "strict_min_version": "142.0" },
    "gecko": {
      "id": "rotblock@jeemzy.github.io",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/jeemzy/rotblock/main/updates.json",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
